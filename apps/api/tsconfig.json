{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "./dist",
    "noEmit": false,
    "module": "CommonJS",
    "moduleResolution": "node",
    "types": ["node"],
    "baseUrl": "."
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "prisma/seed.ts",
    "src/scripts/**/*",
    "src/services/judge.ts",
    "src/services/problem.service.ts",
    "src/services/matchmaking.service.ts"
  ]
}
